/*
 * Rebuild src/doc/fonts-inline.ts: the PDF's fonts as base64, so server-rendered PDFs never depend on the network.
 *   npm run fonts:inline
 */
import { readFileSync, writeFileSync } from "node:fs";
import { PDF_FONT_FILES } from "../src/lib/pilot/render";

const lines = PDF_FONT_FILES.map((f) => `  "${f}": "${readFileSync(`src/doc/fonts/${f}`).toString("base64")}",`);
writeFileSync("src/doc/fonts-inline.ts", `// Generated by \`npm run fonts:inline\` from src/doc/fonts (Poppins, SIL Open Font Licence: src/doc/fonts/OFL-Poppins.txt).\nexport const INLINE_FONTS: Record<string, string> = {\n${lines.join("\n")}\n};\n`);
console.log(`Inlined ${PDF_FONT_FILES.length} fonts.`);

{
  "$id": "https://kinfield.example/schemas/family-profile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "profileId": {
      "type": "string",
      "pattern": "^FP-[A-Z0-9]{4,12}$"
    },
    "preparedFor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "minLength": 1,
          "description": "Relationship to the older person, e.g. daughter"
        }
      },
      "required": [
        "name",
        "relationship"
      ]
    },
    "person": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "minLength": 1
        },
        "lastName": {
          "type": "string",
          "minLength": 1
        },
        "preferredName": {
          "type": "string"
        },
        "age": {
          "type": "integer",
          "minimum": 50,
          "maximum": 115
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "description": "New Zealand region, e.g. Nelson"
        },
        "town": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "firstName",
        "lastName",
        "age",
        "region",
        "town"
      ]
    },
    "partner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "age": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "health": {
          "type": "string",
          "enum": [
            "well",
            "some_concerns",
            "unwell"
          ]
        }
      },
      "required": [
        "name",
        "age",
        "health"
      ]
    },
    "living": {
      "type": "object",
      "properties": {
        "situation": {
          "type": "string",
          "enum": [
            "alone",
            "with_partner",
            "with_family",
            "retirement_village",
            "residential_care",
            "other"
          ]
        },
        "homeType": {
          "type": "string",
          "enum": [
            "house",
            "unit",
            "apartment",
            "village_unit",
            "care_facility"
          ]
        },
        "ownsHome": {
          "type": "boolean"
        }
      },
      "required": [
        "situation",
        "homeType",
        "ownsHome"
      ]
    },
    "support": {
      "type": "object",
      "properties": {
        "current": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "family",
                  "home_help",
                  "personal_care",
                  "meals",
                  "nursing",
                  "day_programme",
                  "other"
                ]
              },
              "provider": {
                "type": "string"
              },
              "hoursPerWeek": {
                "type": "number",
                "minimum": 0,
                "maximum": 168
              },
              "funded": {
                "type": "boolean"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "familySupport": {
          "type": "string",
          "enum": [
            "none",
            "limited",
            "moderate",
            "strong"
          ]
        },
        "mainCarer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "relationship": {
              "type": "string"
            },
            "strain": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            }
          },
          "required": [
            "name",
            "relationship",
            "strain"
          ]
        }
      },
      "required": [
        "familySupport"
      ]
    },
    "mobility": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "independent",
            "uses_aid",
            "needs_help",
            "wheelchair"
          ]
        },
        "fallsLast12Months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "fearOfFalling": {
          "type": "boolean"
        },
        "drives": {
          "type": "boolean"
        }
      },
      "required": [
        "level",
        "fallsLast12Months",
        "fearOfFalling",
        "drives"
      ]
    },
    "health": {
      "type": "object",
      "properties": {
        "conditions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concerns": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "medications": {
          "type": "string",
          "enum": [
            "self",
            "family",
            "pharmacy_packs",
            "needs_help"
          ]
        }
      },
      "required": [
        "medications"
      ]
    },
    "cognition": {
      "type": "object",
      "properties": {
        "concern": {
          "type": "string",
          "enum": [
            "none",
            "mild",
            "moderate",
            "significant"
          ]
        },
        "diagnosis": {
          "type": "string",
          "enum": [
            "none",
            "mci",
            "dementia",
            "unknown"
          ]
        },
        "wandering": {
          "type": "boolean"
        }
      },
      "required": [
        "concern",
        "diagnosis",
        "wandering"
      ]
    },
    "hospital": {
      "type": "object",
      "properties": {
        "recentAdmission": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "none",
            "in_hospital",
            "discharged_recently"
          ]
        },
        "reason": {
          "type": "string"
        },
        "dischargeDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "recentAdmission",
        "status"
      ]
    },
    "homeSafety": {
      "type": "object",
      "properties": {
        "concerns": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "smokeAlarms": {
          "type": "boolean"
        },
        "personalAlarm": {
          "type": "boolean"
        },
        "stairs": {
          "type": "boolean"
        }
      },
      "required": [
        "smokeAlarms",
        "personalAlarm",
        "stairs"
      ]
    },
    "funding": {
      "type": "object",
      "properties": {
        "needsAssessment": {
          "type": "string",
          "enum": [
            "none",
            "requested",
            "completed"
          ]
        },
        "assessedLevel": {
          "type": "string",
          "enum": [
            "home_support",
            "rest_home",
            "hospital",
            "dementia"
          ]
        },
        "residentialSubsidy": {
          "type": "string",
          "enum": [
            "not_applicable",
            "considering",
            "applied",
            "approved"
          ]
        },
        "budgetConcern": {
          "type": "string",
          "enum": [
            "none",
            "some",
            "significant"
          ]
        }
      },
      "required": [
        "needsAssessment",
        "residentialSubsidy",
        "budgetConcern"
      ]
    },
    "legal": {
      "type": "object",
      "properties": {
        "epoaProperty": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unsure"
          ]
        },
        "epoaWelfare": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unsure"
          ]
        },
        "epoaActivated": {
          "type": "boolean"
        },
        "will": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unsure"
          ]
        },
        "advanceCarePlan": {
          "type": "boolean"
        }
      },
      "required": [
        "epoaProperty",
        "epoaWelfare",
        "epoaActivated",
        "will",
        "advanceCarePlan"
      ]
    },
    "transport": {
      "type": "object",
      "properties": {
        "mainMode": {
          "type": "string",
          "enum": [
            "drives",
            "family",
            "public",
            "taxi",
            "none"
          ]
        },
        "difficulties": {
          "type": "boolean"
        }
      },
      "required": [
        "mainMode",
        "difficulties"
      ]
    },
    "social": {
      "type": "object",
      "properties": {
        "isolation": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "activities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "isolation"
      ]
    },
    "respite": {
      "type": "object",
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "used": {
          "type": "boolean"
        }
      },
      "required": [
        "needed",
        "used"
      ]
    },
    "future": {
      "type": "object",
      "properties": {
        "preference": {
          "type": "string",
          "enum": [
            "stay_home",
            "retirement_village",
            "residential_care",
            "undecided"
          ]
        },
        "timeframe": {
          "type": "string",
          "enum": [
            "now",
            "within_6_months",
            "within_2_years",
            "later"
          ]
        },
        "weeklyBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "preference",
        "timeframe"
      ]
    },
    "goals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "default": "",
      "type": "string"
    },
    "intake": {
      "type": "object",
      "properties": {
        "completedBy": {
          "type": "string",
          "enum": [
            "self",
            "family_member",
            "partner",
            "friend",
            "helping_person",
            "helping_family",
            "other"
          ]
        },
        "involvement": {
          "type": "string",
          "enum": [
            "active",
            "some",
            "prefers_family",
            "reluctant",
            "difficulty",
            "unable",
            "unsure"
          ]
        },
        "reasonNow": {
          "type": "string",
          "enum": [
            "planning_ahead",
            "noticed_changes",
            "needs_more_help",
            "increasingly_concerned",
            "something_changed",
            "major_event",
            "important_decision",
            "struggling",
            "not_sure"
          ]
        },
        "deadline": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "days",
            "weeks",
            "months",
            "no_deadline",
            "unsure"
          ]
        },
        "deadlineDetail": {
          "default": "",
          "type": "string"
        },
        "worry": {
          "default": "",
          "description": "Q10, in the family's own words",
          "type": "string"
        }
      },
      "required": [
        "completedBy",
        "involvement",
        "reasonNow"
      ]
    },
    "everyday": {
      "type": "object",
      "properties": {
        "needsHelpWith": {
          "default": [],
          "description": "Q12 everyday activities",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changeSinceSixMonths": {
          "default": "same",
          "type": "string",
          "enum": [
            "same",
            "slightly_more",
            "noticeably_more",
            "significantly_more",
            "varies",
            "unsure"
          ]
        },
        "supportSufficient": {
          "default": "unsure",
          "type": "string",
          "enum": [
            "yes",
            "mostly",
            "probably_not",
            "definitely_not",
            "none",
            "unsure"
          ]
        },
        "carerPressure": {
          "default": "unsure",
          "type": "string",
          "enum": [
            "significant",
            "some",
            "possibly",
            "no",
            "unsure"
          ]
        }
      }
    },
    "urgent": {
      "type": "object",
      "properties": {
        "level": {
          "default": "no",
          "type": "string",
          "enum": [
            "no",
            "possibly",
            "yes",
            "unsure"
          ]
        },
        "flags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "default": "",
          "type": "string"
        }
      }
    },
    "village": {
      "type": "object",
      "properties": {
        "locationPreference": {
          "default": "unsure",
          "type": "string",
          "enum": [
            "current_area",
            "near_family",
            "particular_area",
            "flexible",
            "unsure"
          ]
        },
        "preferredArea": {
          "default": "",
          "type": "string"
        },
        "accommodationTypes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "villa",
              "apartment",
              "serviced_apartment",
              "care_suite",
              "open"
            ]
          }
        },
        "independence": {
          "default": "unsure",
          "type": "string",
          "enum": [
            "fully_independent",
            "support_nearby",
            "some_help",
            "significant_needs",
            "increasing",
            "unsure"
          ]
        },
        "onSiteCare": {
          "default": "unsure",
          "type": "string",
          "enum": [
            "essential",
            "important",
            "nice_to_have",
            "not_important",
            "unsure"
          ]
        },
        "mattersMost": {
          "default": [],
          "description": "RV5, including pets, meals, transport and dementia care",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priceBand": {
          "default": "unknown",
          "type": "string",
          "enum": [
            "under_400k",
            "400k_600k",
            "600k_800k",
            "800k_1m",
            "over_1m",
            "unknown",
            "prefer_not_to_say"
          ]
        },
        "timing": {
          "default": "exploring",
          "type": "string",
          "enum": [
            "asap",
            "within_3_months",
            "3_6_months",
            "6_12_months",
            "over_a_year",
            "exploring",
            "unsure"
          ]
        }
      }
    },
    "residentialCare": {
      "type": "object",
      "properties": {
        "stage": {
          "default": "future_only",
          "type": "string",
          "enum": [
            "future_only",
            "wondering",
            "professional_suggested",
            "assessment_identified",
            "actively_looking",
            "urgent",
            "unsure"
          ]
        },
        "assessedLevel": {
          "default": "none",
          "description": "Recorded only when a formal assessment identified it; Ageing Navigator never sets this itself",
          "type": "string",
          "enum": [
            "rest_home",
            "hospital",
            "dementia",
            "psychogeriatric",
            "other",
            "none",
            "unsure"
          ]
        },
        "helpWanted": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "professionals": {
          "default": [],
          "description": "Q29, so the plan does not send families back to people already involved",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alreadyTried": {
          "default": "",
          "type": "string"
        }
      }
    },
    "decisions": {
      "type": "object",
      "properties": {
        "organiser": {
          "default": "unsure",
          "description": "Q28, used as the default owner on new actions",
          "type": "string",
          "enum": [
            "older_person",
            "you",
            "partner",
            "other_family",
            "shared",
            "professional",
            "nobody",
            "unsure"
          ]
        },
        "agreement": {
          "default": "unsure",
          "type": "string",
          "enum": [
            "yes",
            "mostly",
            "some_differences",
            "significant_disagreement",
            "not_discussed",
            "unsure"
          ]
        },
        "distance": {
          "default": "no",
          "type": "string",
          "enum": [
            "no",
            "elsewhere_nz",
            "overseas",
            "several_elsewhere",
            "other"
          ]
        },
        "responsibilityToday": {
          "default": "unsure",
          "type": "string",
          "enum": [
            "older_person",
            "partner",
            "you",
            "other_family",
            "shared",
            "nobody",
            "other",
            "unsure"
          ]
        }
      }
    },
    "barriers": {
      "default": [],
      "description": "Q31, what is making it hardest to move forward",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mostUseful": {
      "default": [],
      "description": "Q32, at most three",
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extra": {
      "default": {},
      "description": "New questionnaire fields land here until the schema adds them",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "profileId",
    "preparedFor",
    "person",
    "living",
    "support",
    "mobility",
    "health",
    "cognition",
    "hospital",
    "homeSafety",
    "funding",
    "legal",
    "transport",
    "social",
    "respite",
    "future"
  ]
}

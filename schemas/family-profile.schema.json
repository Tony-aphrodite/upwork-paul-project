{
  "$id": "https://kinfield.example/schemas/family-profile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "profileId": {
      "type": "string",
      "pattern": "^FP-[A-Z0-9]{4,12}$"
    },
    "preparedFor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "minLength": 1,
          "description": "Relationship to the older person, e.g. daughter"
        }
      },
      "required": [
        "name",
        "relationship"
      ]
    },
    "person": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "minLength": 1
        },
        "lastName": {
          "type": "string",
          "minLength": 1
        },
        "preferredName": {
          "type": "string"
        },
        "age": {
          "type": "integer",
          "minimum": 50,
          "maximum": 115
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "description": "New Zealand region, e.g. Nelson"
        },
        "town": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "firstName",
        "lastName",
        "age",
        "region",
        "town"
      ]
    },
    "partner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "age": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "health": {
          "type": "string",
          "enum": [
            "well",
            "some_concerns",
            "unwell"
          ]
        }
      },
      "required": [
        "name",
        "age",
        "health"
      ]
    },
    "living": {
      "type": "object",
      "properties": {
        "situation": {
          "type": "string",
          "enum": [
            "alone",
            "with_partner",
            "with_family",
            "retirement_village",
            "residential_care",
            "other"
          ]
        },
        "homeType": {
          "type": "string",
          "enum": [
            "house",
            "unit",
            "apartment",
            "village_unit",
            "care_facility"
          ]
        },
        "ownsHome": {
          "type": "boolean"
        }
      },
      "required": [
        "situation",
        "homeType",
        "ownsHome"
      ]
    },
    "support": {
      "type": "object",
      "properties": {
        "current": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "family",
                  "home_help",
                  "personal_care",
                  "meals",
                  "nursing",
                  "day_programme",
                  "other"
                ]
              },
              "provider": {
                "type": "string"
              },
              "hoursPerWeek": {
                "type": "number",
                "minimum": 0,
                "maximum": 168
              },
              "funded": {
                "type": "boolean"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "familySupport": {
          "type": "string",
          "enum": [
            "none",
            "limited",
            "moderate",
            "strong"
          ]
        },
        "mainCarer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "relationship": {
              "type": "string"
            },
            "strain": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            }
          },
          "required": [
            "name",
            "relationship",
            "strain"
          ]
        }
      },
      "required": [
        "familySupport"
      ]
    },
    "mobility": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "independent",
            "uses_aid",
            "needs_help",
            "wheelchair"
          ]
        },
        "fallsLast12Months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "fearOfFalling": {
          "type": "boolean"
        },
        "drives": {
          "type": "boolean"
        }
      },
      "required": [
        "level",
        "fallsLast12Months",
        "fearOfFalling",
        "drives"
      ]
    },
    "health": {
      "type": "object",
      "properties": {
        "conditions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concerns": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "medications": {
          "type": "string",
          "enum": [
            "self",
            "family",
            "pharmacy_packs",
            "needs_help"
          ]
        }
      },
      "required": [
        "medications"
      ]
    },
    "cognition": {
      "type": "object",
      "properties": {
        "concern": {
          "type": "string",
          "enum": [
            "none",
            "mild",
            "moderate",
            "significant"
          ]
        },
        "diagnosis": {
          "type": "string",
          "enum": [
            "none",
            "mci",
            "dementia",
            "unknown"
          ]
        },
        "wandering": {
          "type": "boolean"
        }
      },
      "required": [
        "concern",
        "diagnosis",
        "wandering"
      ]
    },
    "hospital": {
      "type": "object",
      "properties": {
        "recentAdmission": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "none",
            "in_hospital",
            "discharged_recently"
          ]
        },
        "reason": {
          "type": "string"
        },
        "dischargeDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "recentAdmission",
        "status"
      ]
    },
    "homeSafety": {
      "type": "object",
      "properties": {
        "concerns": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "smokeAlarms": {
          "type": "boolean"
        },
        "personalAlarm": {
          "type": "boolean"
        },
        "stairs": {
          "type": "boolean"
        }
      },
      "required": [
        "smokeAlarms",
        "personalAlarm",
        "stairs"
      ]
    },
    "funding": {
      "type": "object",
      "properties": {
        "needsAssessment": {
          "type": "string",
          "enum": [
            "none",
            "requested",
            "completed"
          ]
        },
        "assessedLevel": {
          "type": "string",
          "enum": [
            "home_support",
            "rest_home",
            "hospital",
            "dementia"
          ]
        },
        "residentialSubsidy": {
          "type": "string",
          "enum": [
            "not_applicable",
            "considering",
            "applied",
            "approved"
          ]
        },
        "budgetConcern": {
          "type": "string",
          "enum": [
            "none",
            "some",
            "significant"
          ]
        }
      },
      "required": [
        "needsAssessment",
        "residentialSubsidy",
        "budgetConcern"
      ]
    },
    "legal": {
      "type": "object",
      "properties": {
        "epoaProperty": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unsure"
          ]
        },
        "epoaWelfare": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unsure"
          ]
        },
        "epoaActivated": {
          "type": "boolean"
        },
        "will": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unsure"
          ]
        },
        "advanceCarePlan": {
          "type": "boolean"
        }
      },
      "required": [
        "epoaProperty",
        "epoaWelfare",
        "epoaActivated",
        "will",
        "advanceCarePlan"
      ]
    },
    "transport": {
      "type": "object",
      "properties": {
        "mainMode": {
          "type": "string",
          "enum": [
            "drives",
            "family",
            "public",
            "taxi",
            "none"
          ]
        },
        "difficulties": {
          "type": "boolean"
        }
      },
      "required": [
        "mainMode",
        "difficulties"
      ]
    },
    "social": {
      "type": "object",
      "properties": {
        "isolation": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "activities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "isolation"
      ]
    },
    "respite": {
      "type": "object",
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "used": {
          "type": "boolean"
        }
      },
      "required": [
        "needed",
        "used"
      ]
    },
    "future": {
      "type": "object",
      "properties": {
        "preference": {
          "type": "string",
          "enum": [
            "stay_home",
            "retirement_village",
            "residential_care",
            "undecided"
          ]
        },
        "timeframe": {
          "type": "string",
          "enum": [
            "now",
            "within_6_months",
            "within_2_years",
            "later"
          ]
        },
        "weeklyBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "preference",
        "timeframe"
      ]
    },
    "goals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "default": "",
      "type": "string"
    },
    "extra": {
      "default": {},
      "description": "New questionnaire fields land here until the schema adds them",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "profileId",
    "preparedFor",
    "person",
    "living",
    "support",
    "mobility",
    "health",
    "cognition",
    "hospital",
    "homeSafety",
    "funding",
    "legal",
    "transport",
    "social",
    "respite",
    "future"
  ]
}

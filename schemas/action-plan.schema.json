{
  "$id": "https://kinfield.example/schemas/action-plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "planId": {
      "type": "string",
      "pattern": "^AP-[A-Z0-9]{4,12}$"
    },
    "profileId": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "generatedBy": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string"
        },
        "engineVersion": {
          "type": "string"
        },
        "moduleSet": {
          "type": "string"
        },
        "questionnaireVersion": {
          "description": "Which version of the questionnaire produced the answers, so pilot feedback can be compared",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "engineVersion",
        "moduleSet"
      ]
    },
    "profileHash": {
      "type": "string",
      "description": "Fingerprint of the profile this version was generated from"
    },
    "summary": {
      "type": "object",
      "properties": {
        "situation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attention": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nextStep": {
          "type": "string"
        },
        "urgent": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "no",
                "possibly",
                "yes",
                "unsure"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "guidance": {
              "type": "string"
            }
          },
          "required": [
            "level",
            "items",
            "guidance"
          ]
        }
      },
      "required": [
        "situation",
        "attention",
        "nextStep"
      ]
    },
    "priorities": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "moduleId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "now",
              "soon",
              "plan_ahead"
            ]
          }
        },
        "required": [
          "moduleId",
          "title",
          "why",
          "level"
        ]
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "now",
              "soon",
              "plan_ahead"
            ]
          },
          "noticed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "whyItMatters": {
            "type": "string"
          },
          "whoCanHelp": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "questions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "for": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                }
              },
              "required": [
                "for",
                "question"
              ]
            }
          },
          "usefulInformation": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "sourceId": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "body"
              ]
            }
          },
          "sourceIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actionKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "priority",
          "noticed",
          "actionKeys"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:[a-z0-9-]+$",
            "description": "Stable across versions, so status and notes carry over"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "now",
              "soon",
              "plan_ahead"
            ]
          },
          "timing": {
            "type": "string"
          },
          "responsible": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "waiting_third_party",
              "completed",
              "no_longer_required"
            ]
          },
          "moduleId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "rules",
              "ai",
              "navigator",
              "family"
            ]
          },
          "notes": {
            "default": "",
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "title",
          "description",
          "priority",
          "timing",
          "responsible",
          "status",
          "moduleId",
          "source",
          "createdAt",
          "updatedAt"
        ]
      }
    },
    "providerMatches": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "moduleId": {
            "type": "string"
          },
          "matched": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notMatched": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unknown": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verifiedOn": {
            "description": "When this provider's information was last checked; the questionnaire asks families to be told",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "providerId",
          "name",
          "type",
          "moduleId",
          "matched",
          "notMatched",
          "unknown"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "reviewedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "reviewedOn"
        ]
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "changes": {
            "type": "object",
            "properties": {
              "added": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "removed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "changed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "key",
                    "fields"
                  ]
                }
              },
              "modulesAdded": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "modulesRemoved": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "added",
              "removed",
              "changed",
              "modulesAdded",
              "modulesRemoved"
            ]
          }
        },
        "required": [
          "version",
          "at",
          "reason"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "profileId",
    "version",
    "createdAt",
    "updatedAt",
    "generatedBy",
    "profileHash",
    "summary",
    "priorities",
    "modules",
    "actions",
    "sources",
    "history"
  ]
}

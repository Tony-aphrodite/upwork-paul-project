{
  "$id": "https://kinfield.example/schemas/questionnaire",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Shown on the plan, so answers can be read against the questions that were asked"
    },
    "title": {
      "type": "string"
    },
    "intro": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notice": {
      "type": "string",
      "description": "The scope limits the service must state: no diagnosis, no legal or financial advice, no formal assessment"
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "intro": {
            "type": "string"
          },
          "conditional": {
            "default": false,
            "description": "Shown as a conditional section in the progress bar",
            "type": "boolean"
          },
          "when": {
            "$ref": "#/$defs/__schema0"
          },
          "questions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "single",
                    "multi",
                    "short",
                    "long",
                    "tri_grid"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "help": {
                  "type": "string"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "email"
                  ]
                },
                "optional": {
                  "default": false,
                  "type": "boolean"
                },
                "max": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "options": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "value",
                      "label"
                    ]
                  }
                },
                "items": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]+$"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "label"
                    ]
                  }
                },
                "when": {
                  "description": "Evaluated against the answers given so far",
                  "$ref": "#/$defs/__schema0"
                }
              },
              "required": [
                "id",
                "type",
                "label"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "questions"
        ]
      }
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "notice",
    "sections"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "neq",
                "in",
                "gte",
                "lte",
                "truthy",
                "falsy",
                "includes",
                "exists"
              ]
            },
            "value": {}
          },
          "required": [
            "field",
            "op"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

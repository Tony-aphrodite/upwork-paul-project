{
  "$id": "https://kinfield.example/schemas/module-definition",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "when": {
      "description": "The module appears only when this is true",
      "$ref": "#/$defs/__schema0"
    },
    "priority": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "now",
            "soon",
            "plan_ahead"
          ]
        },
        "rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "$ref": "#/$defs/__schema0"
              },
              "level": {
                "type": "string",
                "enum": [
                  "now",
                  "soon",
                  "plan_ahead"
                ]
              }
            },
            "required": [
              "when",
              "level"
            ]
          }
        }
      },
      "required": [
        "default"
      ]
    },
    "headline": {
      "type": "string",
      "description": "Short title used in Top Priorities"
    },
    "noticed": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "when": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "whyItMatters": {
      "type": "string"
    },
    "whoCanHelp": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "for": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "when": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "for",
          "question"
        ]
      }
    },
    "information": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "when": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "title",
          "body"
        ]
      }
    },
    "actions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "timing": {
            "type": "string"
          },
          "responsible": {
            "type": "string"
          },
          "priority": {
            "description": "Defaults to the module's priority",
            "type": "string",
            "enum": [
              "now",
              "soon",
              "plan_ahead"
            ]
          },
          "when": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "timing",
          "responsible"
        ]
      }
    },
    "providerTypes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "title",
    "order",
    "when",
    "priority",
    "headline",
    "noticed",
    "actions"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "neq",
                "in",
                "gte",
                "lte",
                "truthy",
                "falsy",
                "includes",
                "exists"
              ]
            },
            "value": {}
          },
          "required": [
            "field",
            "op"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
